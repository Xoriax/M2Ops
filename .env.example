# Mot de passe du compte admin de Cronicle (http://localhost:3012). A changer.
CRONICLE_ADMIN_PASSWORD=changeme

# Alerte en cas d'echec : URL de webhook entrant (Discord, Slack, Mattermost, Teams). Optionnel, sans SMTP.
ALERT_WEBHOOK_URL=

# URL de ping (type healthchecks.io) appelee en fin de run reussi. Optionnel.
HEALTHCHECK_URL=

# Postgres (pas encore utilise par le collecteur)
POSTGRES_USER=gazette
POSTGRES_PASSWORD=gazette
POSTGRES_DB=gazette
